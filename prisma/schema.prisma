generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum WaitlistStatus {
  PENDING
  INVITED
  ONBOARDED
  REJECTED
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  email     String         @unique
  status    WaitlistStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum StoreMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OrderStatus {
  PENDING
  PENDING_VERIFICATION
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  FLUTTERWAVE
  MANUAL_TRANSFER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  platformRole  UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  storeMembers  StoreMember[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? 
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  country     String
  currency       String
  description    String?
  logoUrl        String?
  primaryColor   String?     @default("#2563eb")
  
  heroHeadline   String?
  heroSubtext    String?
  heroImage      String?
  aboutText      String?
  instagramHandle String?
  whatsappNumber String?
  tiktokHandle   String?
  snapchatHandle String?
  contactEmail   String?
  deliveryPolicy String?

  status         StoreStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members      StoreMember[]
  domains      Domain[]
  products     Product[]
  categories   Category[]
  customers    Customer[]
  orders       Order[]
  subscription Subscription?
  paymentSetting StorePaymentSetting?
  discounts    Discount[]
  shippingZones ShippingZone[]
  reviews      Review[]
  supportTickets SupportTicket[]
  analytics    StoreAnalytics[]
}

model StoreMember {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  role      StoreMemberRole @default(STAFF)
  createdAt DateTime        @default(now())
  
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

model Domain {
  id         String   @id @default(cuid())
  storeId    String
  domainName String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(cuid())
  storeId          String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments         SubscriptionPayment[]
}

model SubscriptionPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  amount          Float
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentMethod   String   // BANK_TRANSFER, MOMO
  reference       String   // Transaction ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id        String         @id @default(cuid())
  name      String
  price     Float
  currency  String         @default("USD")
  interval  String         @default("month")
  features  String?        // JSON string
  
  subscriptions Subscription[]
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  isActive    Boolean  @default(true) // Legacy, but keeping for compatibility
  status      ProductStatus @default(ACTIVE)
  visibility  ProductVisibility @default(VISIBLE)
  isFeatured  Boolean  @default(false)
  
  // Pricing & Inventory (Global)
  price       Float?
  compareAtPrice Float?
  sku         String?
  stockCount  Int      @default(0)
  lowStockThreshold Int @default(5)

  // Media
  images      String[] // Array of image URLs
  sizeGuideUrl String?
  videoUrl    String?

  // Simple Variants (Comma separated strings)
  availableSizes String?
  availableColors String?

  // SEO
  seoTitle       String?
  seoDescription String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  options     ProductOption[]
  categories  Category[]     @relation("ProductToCategory")
  reviews     Review[]
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g. "Size", "Flavor", "Material"
  position  Int      @default(0)
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id        String   @id @default(cuid())
  optionId  String
  value     String   // e.g. "Small", "Red", "Plastic"
  
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  ProductVariant[] @relation("VariantToOptionValue")

  @@unique([optionId, value])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String?
  price          Float
  compareAtPrice Float?
  stockCount     Int      @default(0)
  imageUrl       String?
  
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  optionValues   ProductOptionValue[] @relation("VariantToOptionValue")
  inventoryHistory InventoryHistory[]
}

enum InventoryChangeReason {
  PURCHASE
  RESTOCK
  RETURN
  DAMAGE
  CORRECTION
}

model InventoryHistory {
  id          String   @id @default(cuid())
  variantId   String
  quantity    Int      // Positive for restock, negative for deduction
  reason      InventoryChangeReason
  referenceId String?  // Optional order ID or reference
  createdAt   DateTime @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  slug      String
  
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[] @relation("ProductToCategory")

  @@unique([storeId, slug])
}

model Customer {
  id         String   @id @default(cuid())
  storeId    String
  name       String
  email      String?
  phone      String?
  totalSpent Float    @default(0)
  createdAt  DateTime @default(now())

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders     Order[]
  reviews    Review[]
  supportTickets SupportTicket[]

  @@unique([storeId, email])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  customerId      String
  orderNumber     String
  totalAmount     Float
  taxAmount       Float       @default(0)
  shippingAmount  Float       @default(0)
  status          OrderStatus @default(PENDING)
  shippingAddress String?     
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id        String          @id @default(cuid())
  orderId   String
  provider  PaymentProvider
  status    String          
  reference String?
  amount    Float
  createdAt DateTime        @default(now())

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StorePaymentSetting {
  id                String          @id @default(cuid())
  storeId           String          @unique
  provider          PaymentProvider
  isActive          Boolean         @default(false)
  bankName          String?
  accountName       String?
  accountNumber     String?
  mobileMoneyNumber String?
  instructions      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique 
  type            String
  status          String   @default("PROCESSED")
  createdAt       DateTime @default(now())
}

model Discount {
  id            String   @id @default(cuid())
  storeId       String
  code          String
  type          String   // "PERCENTAGE" or "FIXED"
  value         Float
  startDate     DateTime @default(now())
  endDate       DateTime?
  isActive      Boolean  @default(true)
  usageLimit    Int?
  timesUsed     Int      @default(0)
  
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@unique([storeId, code])
}

model ShippingZone {
  id            String   @id @default(cuid())
  storeId       String
  name          String   // e.g. "Domestic", "International"
  countries     String[] // Array of country codes
  
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates         ShippingRate[]
}

model ShippingRate {
  id             String   @id @default(cuid())
  zoneId         String
  name           String   // e.g. "Standard Shipping", "Express"
  price          Float
  estimatedDays  String?  
  
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  customerId String?
  rating    Int      
  comment   String?
  status    String   @default("PUBLISHED") 
  createdAt DateTime @default(now())

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  subject     String
  message     String
  status      String   @default("OPEN") 
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model StoreAnalytics {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date        DateTime
  pageViews   Int      @default(0)
  visitors    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, date])
  @@index([storeId])
}

model PlatformAnalytics {
  id          String   @id @default(cuid())
  date        DateTime
  pageViews   Int      @default(0)
  visitors    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
}
