generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum WaitlistStatus {
  PENDING
  INVITED
  ONBOARDED
  REJECTED
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  email     String         @unique
  status    WaitlistStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum StoreMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OrderStatus {
  PENDING
  PENDING_VERIFICATION
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  WALK_IN
  PHONE
  OTHER
  /// Sold at the seller's physical shop through the Shopora till
  POS
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  FLUTTERWAVE
  MANUAL_TRANSFER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  platformRole  UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  storeMembers  StoreMember[]
  accounts      Account[]
  sessions      Session[]
  pushTokens    PushToken[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? 
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Store {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  country     String
  currency       String
  description    String?
  logoUrl        String?
  primaryColor   String?     @default("#2563eb")
  
  heroHeadline   String?
  heroSubtext    String?
  /// Short line in the storefront's top bar (defaults to the delivery note when empty)
  announcementText String?
  heroImage      String?
  aboutText      String?
  instagramHandle String?
  whatsappNumber String?
  tiktokHandle   String?
  snapchatHandle String?
  contactEmail   String?
  deliveryPolicy String?
  /// Seller's own privacy policy for their storefront (a default is shown when empty)
  privacyPolicy  String?
  /// Seller's own returns & refunds policy (a default is shown when empty)
  returnPolicy   String?

  // Shopora Delivery (Accra v1)
  shoporaDeliveryEnabled Boolean @default(false)
  pickupAddress          String?
  pickupCity             String?
  pickupLat              Float?
  pickupLng              Float?

  /// Sales target for the current month, shown on the seller's home screen
  monthlyGoal    Float?
  /// Send new-order alerts to the store's WhatsApp number (needs the WhatsApp Business API set up)
  whatsappOrderAlerts Boolean @default(false)

  status         StoreStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  members      StoreMember[]
  invites      StoreInvite[]
  domains      Domain[]
  products     Product[]
  categories   Category[]
  customers    Customer[]
  orders       Order[]
  subscription Subscription?
  paymentSetting StorePaymentSetting?
  discounts    Discount[]
  shippingZones ShippingZone[]
  reviews      Review[]
  supportTickets SupportTicket[]
  analytics    StoreAnalytics[]
}

model StoreMember {
  id        String          @id @default(cuid())
  storeId   String
  userId    String
  role      StoreMemberRole @default(STAFF)
  createdAt DateTime        @default(now())
  
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

/// Someone invited to help run a store who doesn't have a Shopora account yet; claimed when they sign up or log in.
model StoreInvite {
  id          String          @id @default(cuid())
  storeId     String
  email       String
  role        StoreMemberRole @default(STAFF)
  invitedById String?
  createdAt   DateTime        @default(now())

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([email])
}

model Domain {
  id         String   @id @default(cuid())
  storeId    String
  domainName String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Subscription {
  id                  String             @id @default(cuid())
  storeId             String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIAL)
  currentPeriodEnd    DateTime?
  isEarlyBird         Boolean            @default(false)
  earlyBirdMonthsUsed Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments         SubscriptionPayment[]

  @@index([planId])
}

model SubscriptionPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  amount          Float
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentMethod   String   // BANK_TRANSFER, MOMO
  reference       String   // Transaction ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model SubscriptionPlan {
  id        String         @id @default(cuid())
  name      String
  price     Float
  currency  String         @default("GHS")
  interval  String         @default("month")
  features  String?        // JSON string
  
  subscriptions Subscription[]
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  isActive    Boolean  @default(true) // Legacy, but keeping for compatibility
  status      ProductStatus @default(ACTIVE)
  visibility  ProductVisibility @default(VISIBLE)
  isFeatured  Boolean  @default(false)
  
  // Pricing & Inventory (Global)
  price       Float?
  compareAtPrice Float?
  /// What the seller paid per item, for profit reports (variants inherit it unless they set their own)
  costPrice   Float?
  sku         String?
  stockCount  Int      @default(0)
  lowStockThreshold Int @default(5)

  // Media
  images      String[] // Array of image URLs
  sizeGuideUrl String?
  videoUrl    String?

  // Simple Variants (Comma separated strings)
  availableSizes String?
  availableColors String?

  // SEO
  seoTitle       String?
  seoDescription String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  options     ProductOption[]
  categories  Category[]     @relation("ProductToCategory")
  reviews     Review[]

  @@index([storeId])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g. "Size", "Flavor", "Material"
  position  Int      @default(0)
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id        String   @id @default(cuid())
  optionId  String
  value     String   // e.g. "Small", "Red", "Plastic"
  
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  ProductVariant[] @relation("VariantToOptionValue")

  @@unique([optionId, value])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String?
  price          Float
  compareAtPrice Float?
  costPrice      Float?
  stockCount     Int      @default(0)
  imageUrl       String?
  
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  optionValues   ProductOptionValue[] @relation("VariantToOptionValue")
  inventoryHistory InventoryHistory[]

  @@index([productId])
}

enum InventoryChangeReason {
  PURCHASE
  RESTOCK
  RETURN
  DAMAGE
  CORRECTION
}

model InventoryHistory {
  id          String   @id @default(cuid())
  variantId   String
  quantity    Int      // Positive for restock, negative for deduction
  reason      InventoryChangeReason
  referenceId String?  // Optional order ID or reference
  createdAt   DateTime @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  slug      String
  
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[] @relation("ProductToCategory")

  @@unique([storeId, slug])
}

model Customer {
  id         String   @id @default(cuid())
  storeId    String
  name       String
  email      String?
  phone      String?
  totalSpent Float    @default(0)
  /// Private notes and labels the seller keeps about this customer
  notes      String?
  tags       String[] @default([])
  createdAt  DateTime @default(now())

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders     Order[]
  reviews    Review[]
  supportTickets SupportTicket[]

  @@unique([storeId, email])
}

enum DeliveryMethod {
  VENDOR
  SHOPORA
}

enum RiderType {
  MANAGED
  INDEPENDENT
}

enum RiderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DeliveryJobStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryFailReason {
  CUSTOMER_UNAVAILABLE
  INCORRECT_ADDRESS
  CUSTOMER_REFUSED
  UNABLE_TO_CONTACT
  OTHER
}

enum DeliveryAuditAction {
  ACCEPTED
  PICKED_UP
  DELIVERED
  FAILED
  REOPENED
  CANCELLED
  ASSIGNED_MANUAL
  OTP_FAILED
  TIMEOUT_WARN
  TIMEOUT_REOPEN
}

enum RiderWalletEntryType {
  DELIVERY_CUT
  SETTLEMENT
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  customerId      String
  orderNumber     String
  totalAmount     Float
  taxAmount       Float       @default(0)
  shippingAmount  Float       @default(0)
  status          OrderStatus @default(PENDING)
  shippingAddress String?
  deliveryMethod  DeliveryMethod @default(VENDOR)
  deliveryDistanceKm Float?
  deliveryDurationMin Float?
  shoporaCutAmount Float?
  deliveryQuotedAt DateTime?
  /// Exact delivery pin chosen by the customer at checkout (GPS or map)
  dropoffLat      Float?
  dropoffLng      Float?
  /// True while this order's items are taken out of stock (set at checkout, cleared on cancel/refund)
  stockReserved   Boolean     @default(false)
  /// Where the sale came from; anything but WEBSITE was recorded by the seller
  source          OrderSource @default(WEBSITE)
  /// Seller's private note on the order
  notes           String?
  /// Till sales: how the customer paid (CASH, MOMO, CARD, BANK) and cash handed over
  tillPaymentMethod String?
  amountTendered  Float?
  trackingToken   String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  payments        Payment[]
  deliveryJob     DeliveryJob?

  @@index([storeId])
  @@index([customerId])
}

model Rider {
  id              String      @id @default(cuid())
  name            String
  phone           String      @unique
  email           String?
  momoNumber      String?
  passwordHash    String
  type            RiderType   @default(MANAGED)
  status          RiderStatus @default(PENDING)
  city            String      @default("Accra")
  /// Available for new Accra jobs
  isOnline        Boolean     @default(false)
  lastOnlineAt    DateTime?
  /// When the rider accepted Shopora rider terms
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Running amount this rider owes Shopora (platform cut not yet settled)
  walletOwed      Float       @default(0)
  /// Cached average of customer ratings (1–5)
  ratingAvg       Float       @default(0)
  ratingCount     Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  jobs            DeliveryJob[]
  walletEntries   RiderWalletEntry[]
  auditLogs       DeliveryAuditLog[]
  ratings         RiderRating[]
  pushTokens      PushToken[]
}

/// Expo push tokens from the Shopora mobile app. A device belongs to either a seller (userId) or a rider (riderId).
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  riderId   String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider     Rider?   @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riderId])
}

model RiderRating {
  id            String   @id @default(cuid())
  deliveryJobId String   @unique
  riderId       String
  orderId       String
  stars         Int
  comment       String?
  createdAt     DateTime @default(now())

  deliveryJob   DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  rider         Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([orderId])
}

/// Accra delivery zones — keyword match on dropoff address adjusts live fee.
model DeliveryZone {
  id            String   @id @default(cuid())
  name          String
  /// Comma-separated area keywords, e.g. "east legon,airport residential"
  keywords      String
  isActive      Boolean  @default(true)
  /// Multiply calculated fee (1 = no change, 1.2 = +20%)
  feeMultiplier Float    @default(1)
  /// Extra GHS added after multiplier
  flatAdd       Float    @default(0)
  minFee        Float?
  maxFee        Float?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeliveryJob {
  id              String            @id @default(cuid())
  orderId         String            @unique
  riderId         String?
  previousRiderId String?
  status          DeliveryJobStatus @default(PENDING)
  feeAmount       Float
  riderPayout     Float
  shoporaCut      Float
  pickupAddress   String
  dropoffAddress  String
  dropoffLat      Float?
  dropoffLng      Float?
  distanceKm      Float?
  durationMin     Float?
  /// bcrypt hash of the customer delivery OTP — never expose plaintext to riders
  deliveryOtpHash String?
  /// Plain OTP only for the customer track page / email — never selected in rider queries
  deliveryOtpCode String?
  deliveryOtpExpiresAt DateTime?
  deliveryOtpAttempts Int           @default(0)
  failedReason    DeliveryFailReason?
  failedNotes     String?
  failedAt        DateTime?
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider           Rider?            @relation(fields: [riderId], references: [id])
  walletEntries   RiderWalletEntry[]
  auditLogs       DeliveryAuditLog[]
  rating          RiderRating?

  @@index([riderId])
  @@index([status])
}

model DeliveryAuditLog {
  id            String              @id @default(cuid())
  deliveryJobId String
  riderId       String?
  actorType     String              // RIDER | ADMIN | SYSTEM
  actorId       String?
  action        DeliveryAuditAction
  note          String?
  createdAt     DateTime            @default(now())

  deliveryJob   DeliveryJob         @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  rider         Rider?              @relation(fields: [riderId], references: [id])

  @@index([deliveryJobId])
  @@index([createdAt])
}

model RiderWalletEntry {
  id            String               @id @default(cuid())
  riderId       String
  deliveryJobId String?
  type          RiderWalletEntryType
  /// Positive = rider owes Shopora more; negative = settlement payment
  amount        Float
  note          String?
  createdAt     DateTime             @default(now())

  rider         Rider                @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryJob   DeliveryJob?         @relation(fields: [deliveryJobId], references: [id])

  @@index([riderId])
  @@index([deliveryJobId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float
  /// Cost per item when it sold, so later cost changes don't rewrite past profit
  costPrice Float?

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id        String          @id @default(cuid())
  orderId   String
  provider  PaymentProvider
  status    String          
  reference String?
  amount    Float
  createdAt DateTime        @default(now())

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StorePaymentSetting {
  id                String          @id @default(cuid())
  storeId           String          @unique
  provider          PaymentProvider
  isActive          Boolean         @default(false)
  bankName          String?
  accountName       String?
  accountNumber     String?
  mobileMoneyNumber String?
  instructions      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique 
  type            String
  status          String   @default("PROCESSED")
  createdAt       DateTime @default(now())
}

model Discount {
  id            String   @id @default(cuid())
  storeId       String
  code          String
  type          String   // "PERCENTAGE" or "FIXED"
  value         Float
  startDate     DateTime @default(now())
  endDate       DateTime?
  isActive      Boolean  @default(true)
  usageLimit    Int?
  timesUsed     Int      @default(0)
  
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@unique([storeId, code])
}

model ShippingZone {
  id            String   @id @default(cuid())
  storeId       String
  name          String   // e.g. "Domestic", "International"
  countries     String[] // Array of country codes
  
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates         ShippingRate[]

  @@index([storeId])
}

model ShippingRate {
  id             String   @id @default(cuid())
  zoneId         String
  name           String   // e.g. "Standard Shipping", "Express"
  price          Float
  estimatedDays  String?  
  
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

model Review {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  customerId String?
  rating    Int      
  comment   String?
  status    String   @default("PUBLISHED") 
  createdAt DateTime @default(now())

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([productId])
  @@index([customerId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  subject     String
  message     String
  status      String   @default("OPEN") 
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
}

model StoreAnalytics {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date        DateTime
  pageViews   Int      @default(0)
  visitors    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, date])
}

model PlatformAnalytics {
  id          String   @id @default(cuid())
  date        DateTime
  pageViews   Int      @default(0)
  visitors    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
}
